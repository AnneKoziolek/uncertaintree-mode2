<?xml version="1.0" encoding="UTF-8"?>
<simulink:SimulinkModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:simulink="http://vitruv.tools/methodologisttemplate/simulink" version="1.0">
  <contains name="piston_diameter_parameter_block">
    <parameters name="piston_diameter_parameter_block_parameter" type="Float" value="57.0"/>
    <ports xsi:type="simulink:OutPort" name="Piston_Diameter" connection="//@connection.6"/>
  </contains>
  <contains name="number_of_pistons_block">
    <parameters name="number_of_pistons_block_parameter" type="Integer" value="4"/>
    <ports xsi:type="simulink:OutPort" name="No_Pistons" connection="//@connection.5"/>
  </contains>
  <contains name="sim_block">
    <ports xsi:type="simulink:OutPort" name="speed_in_ms"/>
    <ports xsi:type="simulink:OutPort" name="brake_force_in_NM"/>
    <ports xsi:type="simulink:InPort" name="env_temp_in_C" connection="//@connection.0"/>
    <ports xsi:type="simulink:InPort" name="speed_signal_ms" connection="//@connection.1"/>
    <ports xsi:type="simulink:InPort" name="clamp_force_in_bar" connection="//@connection.2"/>
    <ports xsi:type="simulink:InPort" name="vibration_in_mym" connection="//@connection.3"/>
  </contains>
  <contains name="Clamp-Force Block">
    <ports xsi:type="simulink:OutPort" name="clamp_force_in_bar" connection="//@connection.2"/>
    <ports xsi:type="simulink:InPort" name="applied_line_pressure_in_bar" connection="//@connection.4"/>
    <ports xsi:type="simulink:InPort" name="number_of_pistons" connection="//@connection.5"/>
    <ports xsi:type="simulink:InPort" name="piston_diameter_in_mm" connection="//@connection.6"/>
  </contains>
  <contains name="TimeBlock">
    <ports xsi:type="simulink:OutPort" name="time_in_s" connection="//@connection.15"/>
  </contains>
  <contains name="Env_Temp_Start_0:00">
    <ports xsi:type="simulink:InPort" name="env_temp_time_signal_start" connection="//@connection.15/@connections.0"/>
    <ports xsi:type="simulink:OutPort" name="env_temp_time_signal_less_than" connection="//@connection.13"/>
  </contains>
  <contains name="Env_Temp_End_1:25">
    <ports xsi:type="simulink:InPort" name="env_temp_time_signal_end" connection="//@connection.15/@connections.1"/>
    <ports xsi:type="simulink:OutPort" name="env_temp_time_signal_greater_equals" connection="//@connection.12"/>
  </contains>
  <contains name="Env_Temp_Enabler_AND">
    <ports xsi:type="simulink:InPort" name="Env_Temp_Time_Less_Than" connection="//@connection.7"/>
    <ports xsi:type="simulink:InPort" name="Env_Temp_Time_Greater_Or_Equal" connection="//@connection.8"/>
    <ports xsi:type="simulink:OutPort" name="Env_Temp_Time_Enable" connection="//@connection.16"/>
  </contains>
  <contains name="Env_Speed_Start_0:00">
    <ports xsi:type="simulink:InPort" name="env_speed_time_signal_start" connection="//@connection.15/@connections.2"/>
    <ports xsi:type="simulink:OutPort" name="env_speed_time_signal_less_than" connection="//@connection.9"/>
  </contains>
  <contains name="Env_Speed_End_1:15">
    <ports xsi:type="simulink:InPort" name="env_speed_time_signal_end" connection="//@connection.15/@connections.3"/>
    <ports xsi:type="simulink:OutPort" name="env_speed_time_signal_greater_equals" connection="//@connection.10"/>
  </contains>
  <contains name="Env_Speed_Enabler_AND">
    <ports xsi:type="simulink:InPort" name="Env_Speed_Time_Less_Than" connection="//@connection.9"/>
    <ports xsi:type="simulink:InPort" name="Env_Speed_Time_Greater_Or_Equal" connection="//@connection.10"/>
    <ports xsi:type="simulink:OutPort" name="Env_Speed_Time_Enable" connection="//@connection.17"/>
  </contains>
  <contains name="Env_Line_Pressure_Start_1:15">
    <ports xsi:type="simulink:InPort" name="env_line_pressure_time_signal_start" connection="//@connection.15/@connections.4"/>
    <ports xsi:type="simulink:OutPort" name="env_line_pressure_time_signal_less_than"/>
  </contains>
  <contains name="Env_Line_Pressure_End_1:20">
    <ports xsi:type="simulink:InPort" name="env_line_pressure_time_signal_end" connection="//@connection.15/@connections.5"/>
    <ports xsi:type="simulink:OutPort" name="env_line_pressure_time_signal_greater_equals" connection="//@connection.11"/>
  </contains>
  <contains name="Env_Line_Pressure_Enabler_AND">
    <ports xsi:type="simulink:InPort" name="Env_Line_Pressure_Time_Less_Than" connection="//@connection.11"/>
    <ports xsi:type="simulink:InPort" name="Env_Line_Pressure_Time_Greater_Or_Equal" connection="//@connection.14"/>
    <ports xsi:type="simulink:OutPort" name="Env_Line_Pressure_Time_Enable" connection="//@connection.18"/>
  </contains>
  <contains name="Env_Vibration_Start_0:10">
